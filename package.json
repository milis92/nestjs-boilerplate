{
  "name": "nestjs-backend-boilerplate",
  "private": true,
  "version": "1.0.0",
  "description": "Production-ready NestJS backend boilerplate with auth, caching, rate limiting, GraphQL, and more",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level high",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --inspect-brk --pool forks --poolOptions.forks.singleFork --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "test:all": "vitest run",
    "db:generate": "dotenvx run -- drizzle-kit generate",
    "db:migrate": "dotenvx run -- sh -c 'pnpm dlx @better-auth/cli migrate --yes && drizzle-kit migrate'",
    "docker:up": "docker compose --env-file .env -f docker-compose.yml up -d --wait",
    "docker:down": "docker compose --env-file .env -f docker-compose.yml down",
    "prepare": "lefthook install"
  },
  "engines": {
    "pnpm": ">=11.2.2",
    "node": ">=v24.16.0"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.0-beta.2",
    "@ai-sdk/google": "4.0.0-beta.8",
    "@ai-sdk/openai": "4.0.0-beta.6",
    "@apollo/server": "5.4.0",
    "@as-integrations/express5": "1.1.2",
    "@better-auth/api-key": "1.5.5",
    "@bull-board/api": "7.0.0",
    "@bull-board/express": "7.0.0",
    "@bull-board/nestjs": "7.0.0",
    "@dotenvx/dotenvx": "1.52.0",
    "@keyv/redis": "5.1.6",
    "@nest-lab/throttler-storage-redis": "1.1.0",
    "@nestjs/apollo": "13.2.3",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.2",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/graphql": "13.2.3",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.5.0",
    "@scalar/nestjs-api-reference": "1.0.13",
    "@tygra/nestjs-graceful-shutdown": "2.0.0",
    "@types/express": "5.0.6",
    "ai": "7.0.0-beta.15",
    "better-auth": "1.5.5",
    "bullmq": "5.71.0",
    "cache-manager": "7.2.8",
    "cacheable": "2.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "drizzle-orm": "1.0.0-rc.3",
    "graphql": "16.12.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "keyv": "5.5.5",
    "multer": "2.1.1",
    "nestjs-pino": "4.5.0",
    "pg": "8.16.3",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.19",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.30",
    "@testcontainers/postgresql": "11.11.0",
    "@testcontainers/redis": "11.13.0",
    "@types/multer": "2.1.0",
    "@types/node": "25.7.0",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.0.18",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-seed": "0.3.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "15.15.0",
    "lefthook": "2.1.6",
    "pino-pretty": "13.1.3",
    "portless": "0.12.0",
    "prettier": "3.7.4",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.6"
  }
}
