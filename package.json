{
  "name": "nestjs-backend-boilerplate",
  "private": true,
  "version": "1.0.0",
  "description": "Production-ready NestJS backend boilerplate with auth, caching, rate limiting, GraphQL, and more",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level high",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --inspect-brk --pool forks --poolOptions.forks.singleFork --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "test:all": "vitest run",
    "db:generate": "dotenvx run -- drizzle-kit generate",
    "db:migrate": "dotenvx run -- sh -c 'pnpm dlx @better-auth/cli migrate --yes && drizzle-kit migrate'",
    "docker:up": "docker compose --env-file .env -f docker-compose.yml up -d --wait",
    "docker:down": "docker compose --env-file .env -f docker-compose.yml down",
    "prepare": "lefthook install"
  },
  "engines": {
    "pnpm": ">=11.2.2",
    "node": ">=v24.16.0"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.0-beta.37",
    "@ai-sdk/google": "4.0.0-beta.45",
    "@ai-sdk/openai": "4.0.0-beta.38",
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@better-auth/api-key": "1.6.11",
    "@bull-board/api": "7.1.5",
    "@bull-board/express": "7.1.5",
    "@bull-board/nestjs": "7.1.5",
    "@dotenvx/dotenvx": "1.66.0",
    "@keyv/redis": "5.1.6",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/apollo": "13.4.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.2",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/graphql": "13.4.0",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "11.4.3",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@scalar/nestjs-api-reference": "1.1.16",
    "@tygra/nestjs-graceful-shutdown": "2.0.0",
    "@types/express": "5.0.6",
    "ai": "7.0.0-beta.111",
    "better-auth": "1.6.11",
    "bullmq": "5.76.9",
    "cache-manager": "7.2.8",
    "cacheable": "2.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "1.0.0-rc.3",
    "graphql": "16.14.0",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "keyv": "5.6.0",
    "multer": "2.1.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.20.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.19",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.30",
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@types/multer": "2.1.0",
    "@types/node": "25.8.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.6",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-seed": "0.3.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "lefthook": "2.1.6",
    "pino-pretty": "13.1.3",
    "portless": "0.13.0",
    "prettier": "3.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.22.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.6"
  }
}
